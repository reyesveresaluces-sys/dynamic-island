<UserControl x:Class="DynamicIsland.TimerSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Temporizador -->
        <Border CornerRadius="16" Background="{StaticResource Surface}" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Temporizador" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="{Binding TimerText}" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular"
                           Foreground="#FFFF9F0A"/>
                <Grid Height="4" Margin="0,4,0,8">
                    <Border CornerRadius="2" Background="#26FFFFFF"/>
                    <Border CornerRadius="2" Background="#FFFF9F0A" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding TimerProgress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource PillButton}" Content="−1 min" Click="Minus_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="+1 min" Margin="6,0,0,0" Click="Plus_Click"/>
                </StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource PillButton}" Content="1" Tag="1" Margin="0,0,5,0" Click="Preset_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="5" Tag="5" Margin="0,0,5,0" Click="Preset_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="10" Tag="10" Margin="0,0,5,0" Click="Preset_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="25" Tag="25" Margin="0,0,5,0" Click="Preset_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="60" Tag="60" Click="Preset_Click"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Content="{Binding TimerButton}" Click="TimerToggle_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="Restablecer" Margin="8,0,0,0" Click="TimerReset_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cronómetro -->
        <Border Grid.Column="2" CornerRadius="16" Background="{StaticResource Surface}" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Cronómetro" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Grid.Row="1" Text="{Binding StopwatchText}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,4"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular"
                           Foreground="#FF30D158"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Laps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,1" Typography.NumeralAlignment="Tabular"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="{Binding StopwatchButton}" Click="SwToggle_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="Vuelta" Margin="6,0,0,0" Click="Lap_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="Reiniciar" Margin="6,0,0,0" Click="SwReset_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
