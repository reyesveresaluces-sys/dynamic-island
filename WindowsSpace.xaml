<UserControl x:Class="DynamicIsland.WindowsSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,2,7">
            <Button x:Name="StashButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                    Content="Guardar la activa" Click="Stash_Click"
                    ToolTip="Minimiza la ventana de enfrente absorbiéndola hacia la isla"/>
            <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <WrapPanel x:Name="Cards"/>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No hay ventanas abiertas" FontSize="12.5"
                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</UserControl>
