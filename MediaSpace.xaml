<UserControl x:Class="DynamicIsland.MediaSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="4,2,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Portada + datos -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="84" Height="84" CornerRadius="14" Background="#1AFFFFFF">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="28"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="84" Height="84" CornerRadius="14">
                <Border.Background>
                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Text="Nada en reproducción"
                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" FontSize="13" Foreground="#FFC7C7CC" Margin="0,2,0,0"
                           Text="Reproduce algo en Spotify, YouTube o tu reproductor" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AppText" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Barra de avance -->
        <Grid x:Name="SeekRow" Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PosText" Text="0:00" FontSize="11" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="1"
                    PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp"/>
            <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="11" TextAlignment="Right"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Controles -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="17" Width="40" Height="40"
                    ToolTip="Anterior" Click="Prev_Click"/>
            <Button Style="{StaticResource IconButton}" Width="48" Height="48" FontSize="24" Margin="10,0"
                    ToolTip="Reproducir / Pausar" Click="PlayPause_Click">
                <TextBlock x:Name="PlayGlyph" Text="&#xE768;"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="17" Width="40" Height="40"
                    ToolTip="Siguiente" Click="Next_Click"/>
        </StackPanel>

        <!-- Volumen general -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" ToolTip="Silenciar" Click="Mute_Click" Width="30" Height="30">
                <TextBlock x:Name="VolumeGlyph" Text="&#xE995;" FontSize="14"/>
            </Button>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="6,0,8,0" Style="{StaticResource IslandSlider}"
                    Minimum="0" Maximum="100" ValueChanged="Volume_ValueChanged"
                    PreviewMouseWheel="Volume_MouseWheel"/>
            <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="11" TextAlignment="Right"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
