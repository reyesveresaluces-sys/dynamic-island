<UserControl x:Class="DynamicIsland.LauncherSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DynamicIsland"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LaunchItem}">
                        <Border x:Name="Tile" Width="78" Height="82" CornerRadius="14" Background="Transparent"
                                Margin="1" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Path}"
                                MouseLeftButtonUp="Tile_Click">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Abrir" Tag="{Binding}" Click="Open_Click"/>
                                    <MenuItem Header="Mostrar en la carpeta" Tag="{Binding}" Click="Reveal_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Mover a la izquierda" Tag="{Binding}" Click="MoveLeft_Click"/>
                                    <MenuItem Header="Mover a la derecha" Tag="{Binding}" Click="MoveRight_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Quitar del lanzador" Tag="{Binding}" Click="Remove_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="36" Height="36"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" FontSize="11" Margin="4,6,4,0"
                                           Foreground="{StaticResource TextPrimary}" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource ItemHover}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="30,0"
                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Arrastra aquí apps, archivos o carpetas para tenerlos a un clic."/>

        <!-- Resalte al arrastrar -->
        <Border x:Name="DropHint" CornerRadius="14" BorderThickness="1.5" BorderBrush="{StaticResource Accent}"
                Background="#1A0A84FF" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Suelta para agregar" FontSize="13" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="2,8,2,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PillButton}" Content="+ App o archivo" Click="AddFile_Click"/>
                <Button Style="{StaticResource PillButton}" Content="+ Carpeta" Margin="6,0,0,0" Click="AddFolder_Click"/>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                       Text="Clic derecho para ordenar o quitar"/>
        </DockPanel>
    </Grid>
</UserControl>
