<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False"
        Width="490" Height="560"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="IslandBg" Color="#F5050506"/>

        <!-- Avatar: ícono de la app o inicial con color -->
        <DataTemplate x:Key="AvatarTemplate" DataType="{x:Type local:IslandNotification}">
            <Grid>
                <Border CornerRadius="9" Background="{Binding AccentBrush}" Visibility="{Binding InitialVisibility}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="9" Visibility="{Binding IconVisibility}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Elemento del historial de notificaciones -->
        <DataTemplate x:Key="HistoryItem" DataType="{x:Type local:IslandNotification}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="14" Padding="8,7" Margin="0,1"
                    Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="HistoryItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarTemplate}"
                                      Width="34" Height="34" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding AppName}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Headline}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#FFC7C7CC"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding BodyVisibility}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseButton}" VerticalAlignment="Top"
                            Tag="{Binding}" Click="HistoryItemRemove_Click" ToolTip="Descartar"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ItemHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Pill"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="150" Height="34" CornerRadius="17"
                Background="{StaticResource IslandBg}"
                BorderBrush="#17FFFFFF" BorderThickness="1"
                AllowDrop="True"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                PreviewMouseWheel="Pill_MouseWheel"
                DragEnter="Pill_DragEnter" DragOver="Pill_DragOver" DragLeave="Pill_DragLeave" Drop="Pill_Drop"
                ContextMenuOpening="Pill_ContextMenuOpening" ContextMenuClosing="Pill_ContextMenuClosing">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>

            <Grid ClipToBounds="True">

                <!-- 1a) Compacta arriba: (portada) + reloj/temporizador + contador / ecualizador -->
                <Grid x:Name="CollapsedView" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Typography.NumeralAlignment="Tabular"/>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Border x:Name="UnreadBadge" Background="{StaticResource Accent}" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" Visibility="Collapsed">
                            <TextBlock x:Name="UnreadText" Text="0" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="EqBars" Orientation="Horizontal" Height="14" Visibility="Collapsed"
                                    VerticalAlignment="Center"/>
                        <Ellipse x:Name="IdleDot" Width="7" Height="7" Fill="#FF30D158"/>
                    </Grid>
                </Grid>

                <!-- 1b) Compacta en un borde lateral (hoja vertical) -->
                <StackPanel x:Name="CollapsedSideView" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" Opacity="0">
                    <Border x:Name="SideArt" Width="18" Height="18" CornerRadius="5" Margin="0,0,0,8"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Grid HorizontalAlignment="Center">
                        <Border x:Name="SideBadge" Background="{StaticResource Accent}" CornerRadius="8" MinWidth="16" Height="16"
                                Padding="3,0" Visibility="Collapsed">
                            <TextBlock x:Name="SideBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="SideEqBars" Orientation="Horizontal" Height="14" Visibility="Collapsed"/>
                        <Ellipse x:Name="SideDot" Width="7" Height="7" Fill="#FF30D158"/>
                    </Grid>
                    <TextBlock x:Name="SideTimerText" FontSize="9.5" FontWeight="SemiBold" Margin="0,8,0,0"
                               HorizontalAlignment="Center" Foreground="#FFFF9F0A" Visibility="Collapsed"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <!-- 2) Banner de notificación entrante -->
                <Grid x:Name="BannerView" Margin="14,12" Visibility="Collapsed" Opacity="0"
                      Cursor="Hand" Background="Transparent"
                      MouseLeftButtonUp="Banner_Click" MouseRightButtonUp="Banner_RightClick">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="BannerAvatar" ContentTemplate="{StaticResource AvatarTemplate}"
                                      Width="46" Height="46" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock x:Name="BannerTime" DockPanel.Dock="Right" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="BannerApp" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="BannerTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBody" FontSize="12.5" Foreground="#FFC7C7CC"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    </StackPanel>
                </Grid>

                <!-- 3) Expandida: espacios -->
                <Grid x:Name="ExpandedView" Margin="14,10,14,14" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pestañas (también se cambian con la rueda del mouse) -->
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ClearButton" Content="Limpiar" Style="{StaticResource PillButton}"
                                    Margin="0,0,8,0" Click="ClearAll_Click"/>
                            <TextBlock x:Name="SpaceTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="Tabs" Orientation="Horizontal">
                            <RadioButton x:Name="TabNotifications" Style="{StaticResource TabButton}" Content="&#xEA8F;"
                                         ToolTip="Notificaciones" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabMedia" Style="{StaticResource TabButton}" Content="&#xE8D6;"
                                         ToolTip="Música y volumen" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabClipboard" Style="{StaticResource TabButton}" Content="&#xE77F;"
                                         ToolTip="Portapapeles" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabLauncher" Style="{StaticResource TabButton}" Content="&#xE71D;"
                                         ToolTip="Apps y carpetas" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabTimer" Style="{StaticResource TabButton}" Content="&#xE916;"
                                         ToolTip="Temporizador y cronómetro" Checked="Tab_Checked"/>
                            <!-- Ícono dibujado (no depende de la fuente de íconos): cuadrícula de zonas -->
                            <RadioButton x:Name="TabZones" Style="{StaticResource TabButton}"
                                         ToolTip="Zonas de ventanas (FancyZones)" Checked="Tab_Checked">
                                <Grid Width="15" Height="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="2"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Rectangle RadiusX="1.5" RadiusY="1.5"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Grid.Column="2" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Grid.Row="2" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Grid.Row="2" Grid.Column="2" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                            <!-- Ventanas abiertas: dos tarjetas apiladas -->
                            <RadioButton x:Name="TabWindows" Style="{StaticResource TabButton}"
                                         ToolTip="Ventanas abiertas" Checked="Tab_Checked">
                                <Grid Width="16" Height="14">
                                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.55"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="SpaceHost" Grid.Row="1">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SpaceShift"/>
                        </Grid.RenderTransform>

                        <!-- Notificaciones -->
                        <Grid x:Name="NotificationsSpace">
                            <TextBlock x:Name="EmptyText" Text="Sin notificaciones recientes"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                                <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryItem}"/>
                            </ScrollViewer>
                        </Grid>

                        <local:MediaSpace x:Name="MediaSpaceView" Visibility="Collapsed"/>
                        <local:ClipboardSpace x:Name="ClipboardSpaceView" Visibility="Collapsed"/>
                        <local:LauncherSpace x:Name="LauncherSpaceView" Visibility="Collapsed"/>
                        <local:TimerSpace x:Name="TimerSpaceView" Visibility="Collapsed"/>
                        <local:ZonesSpace x:Name="ZonesSpaceView" Visibility="Collapsed"/>
                        <local:WindowsSpace x:Name="WindowsSpaceView" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
