<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False"
        Width="460" Height="440"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="IslandBg" Color="#F2050506"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9AA2"/>
        <SolidColorBrush x:Key="ItemHover" Color="#22FFFFFF"/>

        <!-- Botón plano redondeado -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1AFFFFFF" CornerRadius="10" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Width="18" Height="18">
                            <TextBlock Text="✕" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de ícono para los controles de música -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Avatar: ícono de la app o inicial con color -->
        <DataTemplate x:Key="AvatarTemplate" DataType="{x:Type local:IslandNotification}">
            <Grid>
                <Border CornerRadius="9" Background="{Binding AccentBrush}" Visibility="{Binding InitialVisibility}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="9" Visibility="{Binding IconVisibility}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Elemento del historial -->
        <DataTemplate x:Key="HistoryItem" DataType="{x:Type local:IslandNotification}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="14" Padding="8,7" Margin="0,1"
                    Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="HistoryItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarTemplate}"
                                      Width="34" Height="34" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding AppName}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Headline}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#FFC7C7CC"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding BodyVisibility}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseButton}" VerticalAlignment="Top"
                            Tag="{Binding}" Click="HistoryItemRemove_Click" ToolTip="Descartar"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ItemHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Pill"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="150" Height="34" CornerRadius="17"
                Background="{StaticResource IslandBg}"
                BorderBrush="#14FFFFFF" BorderThickness="1"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black"/>
            </Border.Effect>

            <Grid ClipToBounds="True">

                <!-- 1) Estado compacto: (portada) + reloj + contador / ecualizador -->
                <Grid x:Name="CollapsedView" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Border x:Name="UnreadBadge" Background="#FF0A84FF" CornerRadius="9" MinWidth="18" Height="18"
                                Padding="5,0" Visibility="Collapsed">
                            <TextBlock x:Name="UnreadText" Text="0" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="EqBars" Orientation="Horizontal" Height="14" Visibility="Collapsed"
                                    VerticalAlignment="Center"/>
                        <Ellipse x:Name="IdleDot" Width="7" Height="7" Fill="#FF30D158"/>
                    </Grid>
                </Grid>

                <!-- 2) Banner de notificación entrante -->
                <Grid x:Name="BannerView" Margin="14,12" Visibility="Collapsed" Opacity="0"
                      Cursor="Hand" Background="Transparent"
                      MouseLeftButtonUp="Banner_Click" MouseRightButtonUp="Banner_RightClick">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="BannerAvatar" ContentTemplate="{StaticResource AvatarTemplate}"
                                      Width="46" Height="46" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock x:Name="BannerTime" DockPanel.Dock="Right" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="BannerApp" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="BannerTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BannerBody" FontSize="12.5" Foreground="#FFC7C7CC"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    </StackPanel>
                </Grid>

                <!-- 3) Historial al pasar el mouse -->
                <Grid x:Name="HistoryView" Margin="12,10,12,12" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tarjeta de música -->
                    <Border x:Name="MusicCard" Grid.Row="1" Background="#14FFFFFF" CornerRadius="16"
                            Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="10" Background="#26FFFFFF">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22" Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BigArt" Width="56" Height="56" CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush x:Name="BigArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MusicTitle" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MusicArtist" FontSize="12" Foreground="#FFC7C7CC"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MusicApp" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Anterior"
                                        Click="MusicPrev_Click"/>
                                <Button Style="{StaticResource IconButton}" ToolTip="Reproducir / Pausar"
                                        Click="MusicPlayPause_Click" FontSize="18">
                                    <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Siguiente"
                                        Click="MusicNext_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="6,2,2,8">
                        <Button DockPanel.Dock="Right" Content="Limpiar" Style="{StaticResource PillButton}"
                                Click="ClearAll_Click"/>
                        <TextBlock x:Name="HistoryHeader" Text="Notificaciones" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Sin notificaciones recientes"
                               Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryItem}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
