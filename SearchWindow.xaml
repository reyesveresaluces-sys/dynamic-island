<Window x:Class="DynamicIsland.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Buscar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="780" SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9AA2"/>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,7" Margin="8,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0A5BD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:ResultItem}">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="30" Height="30" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <local:HighlightTextBlock MarkedText="{Binding Subtitle}" FontSize="12"
                                              Foreground="#FFB4B4BC" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- El margen deja espacio para la sombra -->
    <Border x:Name="Panel" Margin="28" CornerRadius="20" Background="#F51C1C1F"
            BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Caja de búsqueda -->
            <Grid Height="68" Margin="22,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="14,0,10,0">
                    <TextBlock x:Name="Placeholder" Text="Buscar apps, archivos y dentro de documentos"
                               FontSize="22" Foreground="#FF6E6E76" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="Query" FontSize="22" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}" SelectionBrush="#FF0A84FF"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalContentAlignment="Center" TextChanged="Query_TextChanged"/>
                </Grid>
                <TextBlock x:Name="BusyText" Grid.Column="2" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Resultados + vista previa -->
            <Border x:Name="ResultsArea" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <StackPanel Margin="0,6,0,0">
                    <Grid x:Name="ResultsGrid" Height="500">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListColumn" Width="460"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="Results" Background="Transparent" BorderThickness="0"
                                 Focusable="False" ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 ItemTemplate="{StaticResource ResultTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="Results_SelectionChanged"
                                 MouseLeftButtonUp="Results_MouseLeftButtonUp"/>
                        <TextBlock x:Name="EmptyText" Text="Sin resultados" FontSize="13" Margin="24,12"
                                   Foreground="{StaticResource TextSecondary}" Visibility="Collapsed"
                                   Grid.ColumnSpan="2"/>

                        <!-- Vista previa -->
                        <Grid x:Name="PreviewPane" Grid.Column="1" Margin="6,2,18,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="14" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                    ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="Preview_Click"
                                    ToolTip="Clic para abrir">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <RichTextBox x:Name="PreviewText" IsReadOnly="True" Focusable="False" IsTabStop="False"
                                                 Background="Transparent" BorderThickness="0" Padding="14,12"
                                                 Foreground="#FFE5E5EA" FontSize="12.5" Cursor="Arrow"
                                                 VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                                    <TextBlock x:Name="PreviewLoading" Text="Cargando vista previa…" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Border x:Name="PageBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,14,12" Background="#CC000000" CornerRadius="8" Padding="8,3"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="PageText" FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="4,10,4,0">
                                <TextBlock x:Name="PreviewTitle" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewInfo" FontSize="11.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewPath" FontSize="11" Margin="0,2,0,0"
                                           Foreground="#FF6E6E76" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <DockPanel Margin="22,8,22,12">
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="11" Foreground="#FF6E6E76"/>
                        <TextBlock FontSize="11" Foreground="#FF6E6E76"
                                   Text="↑↓ Vista previa     ↵ Abrir     Ctrl+↵ Mostrar en carpeta     Esc Cerrar"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
